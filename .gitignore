.idea

# Pub workspace resolution output
/.dart_tool/

# Rust workspace build output
/target/

# Linux AppImage
/app/AppDir
/app/appimage-build

.refena_inspector/

/secrets

# FVM Version Cache
.fvm/

# macOS
.DS_Store

# Generated at build time by makepri (see support/scripts/compile_windows_msix_helper.ps1)
/support/build/msix/content/resources.pri

# Left behind by running support/scripts/*.py
/support/scripts/__pycache__/
/.local/

# Android Gradle build output (`app/build/` is covered by app/.gitignore)
/app/android/build/

# Local agent tooling, skills and scratch artifacts
/.agents/
/.pi/
/.rpi/
/.perf-audit/
/.claude/
/skills-lock.json

# Stray shell redirect artifacts (e.g. `cmd > C` / `> nul` on Windows)
/nul
/C

# Binary font files, stripped from history (see README "Fonts (not in git)")
/app/assets/fonts/*.ttf

# Installer payload/result dirs used by support/scripts/compile_windows_exe.ps1
/build/
